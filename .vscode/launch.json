{
  "version": "0.2.0",
  "configurations": [
    {
      // The server reads JSON-RPC from stdin, so it needs a real terminal to
      // type into. Paste a request such as:
      //   {"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}
      "name": "Run server (stdio)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gerrit-mcp-server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // Put GERRIT_URL / GERRIT_USER / GERRIT_TOKEN here. .env is gitignored.
      "envFile": "${workspaceFolder}/.env"
    },
    {
      // Attaching is usually the real way to debug this: let your MCP client
      // spawn the server, then pick its process here. Breakpoints hit while
      // the agent drives it.
      "name": "Attach to running server",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickGoProcess}"
    },
    {
      "name": "Run server (--version)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gerrit-mcp-server",
      "args": ["--version"]
    },
    {
      "name": "Debug tests in current package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "buildFlags": ["-race"]
    },
    {
      "name": "Debug test under cursor",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.run", "${selectedText}"]
    }
  ]
}
