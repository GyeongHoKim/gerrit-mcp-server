{
  "version": "2.0.0",
  // Everything routes through just, so these stay identical to what CI runs.
  "tasks": [
    {
      "label": "just: ci",
      "detail": "Everything CI runs",
      "type": "shell",
      "command": "just ci",
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "just: build",
      "type": "shell",
      "command": "just build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "just: test",
      "type": "shell",
      "command": "just test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "just: test-race",
      "type": "shell",
      "command": "just test-race",
      "group": "test",
      "problemMatcher": ["$go"]
    },
    {
      "label": "just: lint",
      "type": "shell",
      "command": "just lint",
      "problemMatcher": ["$go"]
    },
    {
      "label": "just: lint-fix",
      "type": "shell",
      "command": "just lint-fix",
      "problemMatcher": ["$go"]
    },
    {
      "label": "just: fmt",
      "type": "shell",
      "command": "just fmt",
      "problemMatcher": []
    },
    {
      "label": "just: cover-html",
      "detail": "Run tests and open the coverage report",
      "type": "shell",
      "command": "just cover-html",
      "problemMatcher": ["$go"]
    },
    {
      "label": "just: inspect",
      "detail": "Drive the server through the MCP Inspector",
      "type": "shell",
      "command": "just inspect",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "just: fetch-gerrit-docs",
      "detail": "Refetch the Gerrit REST reference into doc/",
      "type": "shell",
      "command": "just fetch-gerrit-docs",
      "problemMatcher": []
    },
    {
      "label": "just: npm-smoke",
      "detail": "Build, pack and install the npm packages, then run the binary",
      "type": "shell",
      "command": "just npm-smoke",
      "problemMatcher": []
    }
  ]
}
